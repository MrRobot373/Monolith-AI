{
  "name": "aatmiq",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @aatmiq/db generate",
    "db:migrate": "pnpm --filter @aatmiq/db migrate",
    "format": "prettier --write ."
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/client@<2.2.0": "2.3.1",
      "fflate@<0.8.3": "0.8.3",
      "source-map-js@<1.2.2": "1.2.2",
      "uuid@<11.1.1": "11.1.1"
    }
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
