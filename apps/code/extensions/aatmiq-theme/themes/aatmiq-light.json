    "foreground": "#8f8f8f",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "keyword",
    "storage",
    "storage.type",
    "keyword.control"
   ],
   "settings": {
    "foreground": "#7c3aed"
   }
