# ── Aatmiq configuration ──
# Public URL users open in the browser (web app). API is served under /api on the same origin.
APP_URL=http://localhost:3000
# Internal URL the web server uses to reach the API.
API_URL=http://localhost:4000
DATABASE_URL=postgres://aatmiq:aatmiq@localhost:5432/aatmiq
# 32+ random characters. Used for sessions and encrypting stored secrets (provider API keys).
APP_SECRET=change-me-to-a-long-random-string-of-32-chars
# Allow the built-in demo model provider (development/demo only).
ALLOW_MOCK_PROVIDER=true
PORT=4000
