# Aatmiq API (with the Work AI agent runtime and Aatmiq Code)
# Debian, not Alpine: the agent runtime has native modules built for glibc, and tasks need
# ordinary tools (bash, coreutils, Python, git) to do their work.
FROM node:22-bookworm AS build
RUN corepack enable
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .pnpmfile.cjs tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY packages/db/package.json packages/db/
COPY packages/shared/package.json packages/shared/
COPY packages/model-gateway/package.json packages/model-gateway/
COPY packages/license/package.json packages/license/
COPY packages/harness/package.json packages/harness/
COPY packages/skills/package.json packages/skills/
RUN pnpm install --frozen-lockfile --filter @aatmiq/api...
COPY packages packages
COPY apps/api apps/api
RUN pnpm --filter @aatmiq/api build \
 && pnpm --filter @aatmiq/api deploy --prod --legacy /out \
 && cp -r apps/api/dist /out/dist \
 && cp -r packages/db/migrations /out/migrations

# The agent runtime, pinned by deploy/dsh/package-lock.json. npm installs its plugins' peer packages.
FROM node:22-bookworm AS dsh
WORKDIR /opt/dsh
COPY deploy/dsh/package.json deploy/dsh/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund \
 # It also ships a browser UI (Next.js) that Aatmiq never starts.
 && rm -rf node_modules/next node_modules/@next

# Aatmiq Code (the IDE): the pinned Code-OSS server build plus our branding and extensions.
FROM node:22-bookworm AS code
WORKDIR /build/apps/code
COPY apps/code/package.json apps/code/base.json apps/code/product.json apps/code/settings.json ./
COPY apps/code/scripts scripts
COPY apps/code/branding branding
COPY apps/code/extensions extensions
RUN npm install --no-save --no-audit --no-fund @napi-rs/canvas@1 \
 && node scripts/build.mjs --out /opt/aatmiq-code

FROM node:22-bookworm-slim
# Tools the agent uses inside a task folder (the skill library's helper scripts rely on the Python
# packages), and Chromium for the Work AI browser. Add more in your own image.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash ca-certificates curl git jq less procps unzip zip file python3 python3-pip python3-venv openssh-client \
      libnss-wrapper \
      chromium fonts-liberation fonts-noto-color-emoji \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m pip install --no-cache-dir --break-system-packages \
      pandas openpyxl matplotlib python-docx python-pptx reportlab pypdf lxml pyyaml
# The Docker CLI, for container mode (WORK_ISOLATION=container: each Work AI task in its own
# container through the mounted Docker socket). Unused otherwise.
ARG DOCKER_CLI_VERSION=27.5.1
RUN curl -fsSL "https://download.docker.com/linux/static/stable/$(uname -m)/docker-${DOCKER_CLI_VERSION}.tgz" \
  | tar -xz -C /usr/local/bin --strip-components=1 docker/docker
ENV NODE_ENV=production MIGRATIONS_DIR=/app/migrations PORT=4000 STORAGE_DIR=/data/files WORK_DIR=/data/work \
    CODE_DIR=/data/code AATMIQ_CODE_DIST=/opt/aatmiq-code MPLCONFIGDIR=/tmp/matplotlib BROWSER_PATH=/usr/bin/chromium
WORKDIR /app
COPY --from=build /out /app
COPY --from=dsh /opt/dsh /opt/dsh
COPY --from=code /opt/aatmiq-code /opt/aatmiq-code
ENV AATMIQ_DSH_CLI=/opt/dsh/node_modules/@deepseek-ai/dsh/lib/bin.js
# The API runs as root inside the container so each Work AI task and each person's IDE can run as
# its own unprivileged Unix user (no access to documents or anyone else's folders).
# See docs/06-work-ai.md and docs/07-code.md.
RUN mkdir -p /data/files /data/work /data/code && chmod 700 /data/files && chmod 755 /data/work && chmod 711 /data/code
VOLUME /data
EXPOSE 4000
CMD ["node", "dist/server.js"]
