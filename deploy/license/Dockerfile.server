# Aatmiq license server (our cloud): license signing, check-ins, Super Admin API.
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .pnpmfile.cjs tsconfig.base.json ./
COPY apps/license-server/package.json apps/license-server/
COPY packages/license/package.json packages/license/
RUN pnpm install --frozen-lockfile --filter @aatmiq/license-server...
COPY packages/license packages/license
COPY apps/license-server apps/license-server
RUN pnpm --filter @aatmiq/license-server build \
 && pnpm --filter @aatmiq/license-server deploy --prod --legacy /out \
 && cp -r apps/license-server/dist /out/dist \
 && cp -r apps/license-server/migrations /out/migrations

FROM node:22-alpine
ENV NODE_ENV=production MIGRATIONS_DIR=/app/migrations PORT=4100
WORKDIR /app
COPY --from=build /out /app
USER node
EXPOSE 4100
CMD ["node", "dist/server.js"]
