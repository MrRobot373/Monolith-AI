# Public URL of this deployment (what employees type in the browser).
APP_URL=https://ai.yourcompany.com
# Generate with: openssl rand -base64 48
APP_SECRET=
POSTGRES_PASSWORD=
HTTP_PORT=3000
# Keep false in production. true adds a built-in demo model for evaluation.
ALLOW_MOCK_PROVIDER=false

# Read text from images and scanned PDFs locally (Tesseract). Set to false to turn off.
OCR_ENABLED=true

# License: the public key that verifies your license key (sent with your order), and the check-in server.
LICENSE_PUBLIC_KEY=
LICENSE_SERVER_URL=https://license.aatmiq.com

# Work AI: confine commands to their task folder. Use "off" only if the host kernel lacks Landlock
# (Linux 5.13+) and bubblewrap; each task still runs as its own Unix user.
WORK_SANDBOX=on

# Email for invitations and password resets (optional; can also be set in Admin → Settings → Email).
# smtp://user:password@host:587 uses STARTTLS; smtps://…:465 uses TLS. Encode special characters
# in the password (for example @ as %40).
SMTP_URL=
# Sender, for example: Acme AI <ai@yourcompany.com>
MAIL_FROM=

# Where uploads (documents, project files, the logo) are kept. Default: the `files` Docker volume.
# For an S3-compatible bucket (AWS S3, MinIO, Ceph, SeaweedFS, Garage, Cloudflare R2…) set S3_BUCKET.
# With the bundled MinIO (`--profile minio`):
#   S3_BUCKET=aatmiq  S3_ENDPOINT=http://minio:9000  S3_ACCESS_KEY_ID=aatmiq
#   S3_SECRET_ACCESS_KEY=<openssl rand -hex 24>  S3_CREATE_BUCKET=true
# On AWS, leave S3_ENDPOINT and the keys empty to use the instance's IAM role, and set S3_REGION.
# Moving an existing install: docker compose exec api node dist/copy-files-to-s3.js
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional folder inside the bucket, e.g. aatmiq/
S3_PREFIX=
# AES256 or aws:kms to ask the service to encrypt files at rest.
S3_SSE=
S3_CREATE_BUCKET=

# Background jobs (document processing, housekeeping) in a separate worker: start with
# `--profile worker`, set VALKEY_PASSWORD (openssl rand -hex 24) and
# REDIS_URL=redis://:<that password>@valkey:6379 (or point at your own Redis 6.2+).
# Empty: the API runs them itself, which is fine for one server.
VALKEY_PASSWORD=
REDIS_URL=

# Work AI tasks and IDEs can't reach private networks (the database, model servers, your office
# network). Internal hosts they may reach anyway, e.g. an internal GitLab:
# USER_ALLOWED_NETWORKS=10.20.0.15/32, 192.168.40.0/24
USER_ALLOWED_NETWORKS=
# Documents processed at once by each worker (or by the API without Redis).
JOB_CONCURRENCY=2

# Aatmiq Code on its own address (recommended): extensions then run on an origin that holds no Aatmiq
# session, so they can't act on Aatmiq as the person. Point this hostname at the same place as APP_URL
# (port 3000), with TLS. A subdomain is fine; it must differ from APP_URL's host.
# Example: IDE_URL=https://ide.yourcompany.com
IDE_URL=

# Work AI container mode (deploy/docker-compose.containers.yml): tasks start from the API's image.
# Only set this if you tag the API image yourself (default: aatmiq-api, as Compose builds it).
AATMIQ_API_IMAGE=

# A team on one GPU server (deploy/team.sh, docs/10-team-server.md). Empty values use the defaults,
# which fit one 48 GB NVIDIA GPU (RTX A6000, RTX 6000 Ada, L40S):
#   main model  Qwen3.6-35B-A3B (4-bit), 65536 tokens, 68% of the GPU; Chat, Work AI and Code
#   small model Gemma 4 E2B (4-bit), 32768 tokens, 19% of the GPU; Chat, for quick jobs
#   embeddings  EmbeddingGemma 2 (text, 270M) on Ollama, about 1 GB; document search
# Main model: a Hugging Face repo vLLM can serve, the name Aatmiq calls it by, its longest
# conversation and its share of GPU memory.
VLLM_MODEL=
VLLM_MODEL_NAME=
VLLM_MODEL_DISPLAY_NAME=
VLLM_MAX_MODEL_LEN=
VLLM_GPU_MEMORY=
# "Thinking" before answering (slower, better on hard problems), and sampling. With
# VLLM_THINKING=true use VLLM_TEMPERATURE=1.0, VLLM_TOP_P=0.95, VLLM_PRESENCE_PENALTY=0.
VLLM_THINKING=false
VLLM_TEMPERATURE=
VLLM_TOP_P=
VLLM_PRESENCE_PENALTY=
# Small model. Leave it out: set VLLM_SMALL_URL= (empty) and VLLM_GPU_MEMORY=0.87.
VLLM_SMALL_URL=http://vllm-small:8000/v1
VLLM_SMALL_MODEL=
VLLM_SMALL_MODEL_NAME=
VLLM_SMALL_MODEL_DISPLAY_NAME=
VLLM_SMALL_GPU_MEMORY=
# Embeddings for document search: EmbeddingGemma 2 on Ollama, on the GPU (driver with CUDA 13).
# On an older driver: EMBEDDING_MODEL=embeddinggemma (EmbeddingGemma 1, also runs on the CPU).
EMBEDDING_MODEL=
EMBEDDING_MODEL_DISPLAY_NAME=
# Which GPU (0 = the first). Gated models need a Hugging Face token.
VLLM_GPU=
HF_TOKEN=
# Agent tasks working at once across the organization, set at first setup (default 8; Admin →
# Work AI changes it later).
WORK_MAX_RUNNING=

# Nightly backups (deploy/docker-compose.backup.yml). BACKUP_DIR: a folder on another disk or a
# network share (default deploy/backups). TZ is the server's time zone for BACKUP_TIME.
BACKUP_DIR=
BACKUP_TIME=02:30
BACKUP_KEEP=14
TZ=UTC

# HTTPS with Caddy (deploy/docker-compose.https.yml). DOMAIN: the address people open Aatmiq at
# (APP_URL must be https://DOMAIN). IDE_DOMAIN: Aatmiq Code's own address, if IDE_URL is set.
# CADDY_TLS: internal (office network), an email for Let's Encrypt, or certificate files (see
# deploy/caddy/Caddyfile).
DOMAIN=
IDE_DOMAIN=
CADDY_TLS=internal
