# Public URL of this deployment (what employees type in the browser).
APP_URL=https://ai.yourcompany.com
# Generate with: openssl rand -base64 48
APP_SECRET=
POSTGRES_PASSWORD=
HTTP_PORT=3000
# Keep false in production. true adds a built-in demo model for evaluation.
ALLOW_MOCK_PROVIDER=false

# Read text from images and scanned PDFs locally (Tesseract). Set to false to turn off.
OCR_ENABLED=true

# License: the public key that verifies your license key (sent with your order), and the check-in server.
LICENSE_PUBLIC_KEY=
LICENSE_SERVER_URL=https://license.aatmiq.com

# Work AI: confine commands to their task folder. Use "off" only if the host kernel lacks Landlock
# (Linux 5.13+) and bubblewrap; each task still runs as its own Unix user.
WORK_SANDBOX=on

# Email for invitations and password resets (optional; can also be set in Admin → Settings → Email).
# smtp://user:password@host:587 uses STARTTLS; smtps://…:465 uses TLS. Encode special characters
# in the password (for example @ as %40).
SMTP_URL=
# Sender, for example: Acme AI <ai@yourcompany.com>
MAIL_FROM=

# Where uploads (documents, project files, the logo) are kept. Default: the `files` Docker volume.
# For an S3-compatible bucket (AWS S3, MinIO, Ceph, SeaweedFS, Garage, Cloudflare R2…) set S3_BUCKET.
# With the bundled MinIO (`--profile minio`):
#   S3_BUCKET=aatmiq  S3_ENDPOINT=http://minio:9000  S3_ACCESS_KEY_ID=aatmiq
#   S3_SECRET_ACCESS_KEY=<openssl rand -hex 24>  S3_CREATE_BUCKET=true
# On AWS, leave S3_ENDPOINT and the keys empty to use the instance's IAM role, and set S3_REGION.
# Moving an existing install: docker compose exec api node dist/copy-files-to-s3.js
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional folder inside the bucket, e.g. aatmiq/
S3_PREFIX=
# AES256 or aws:kms to ask the service to encrypt files at rest.
S3_SSE=
S3_CREATE_BUCKET=
